---
import Base from "../layouts/Base.astro";
import PageTitle from "../components/PageTitle.astro";
import Stats from "../components/Stats.astro";
import Contact from "../components/Contact.astro";
import { tools, highlights } from "../data/content";
---
<Base title="About — Olanrewaju Alalade">
  <PageTitle text="About" />
  <div class="container"><div class="photo"><img src="/img/photo.png" alt="Olanrewaju Alalade" /></div></div>

  <section class="container">
    <div class="title-sep"><h2>About</h2><span class="rule"></span></div>
    <div class="cols">
      <p class="lead">At the core of my practice is user empathy. I design experiences that help people navigate complexity with confidence—whether it’s managing money, resolving operational issues, or interacting with large-scale financial platforms.</p>
      <div class="right">
        <p>Over the past several years, I’ve worked across fintech, health tech, and enterprise platforms—designing products that balance depth, usability, and real-world constraints.</p>
        <p>My approach is rooted in strong UX fundamentals, structured thinking, and close collaboration with product and engineering teams.</p>
        <p>With over 5+ years of experience in product design, I’ve led design efforts, collaborated across cross-functional teams, and helped translate complex requirements into clear, usable interfaces. I’m particularly interested in systems design, financial workflows, and products where trust, clarity, and reliability matter.</p>
        <p>Whether I’m mapping user flows, refining dashboards, or aligning design decisions with product goals, I’m always asking:<br />How can this be simpler, clearer, and genuinely useful for the people who rely on it?</p>
        <div class="cards">
          {tools.map((t) => (
            <div class="card"><div><h3>{t.name}</h3><p>{t.desc2}</p></div><i></i><b>{t.pct}</b></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="container">
    <div class="title-sep"><h2>Highlights</h2><span class="rule"></span></div>
    <ol class="hl">
      {highlights.map((h, i) => <li><span>{String(i + 1).padStart(2, "0")}</span>{h}</li>)}
    </ol>
  </section>

  <Stats />
  <Contact />
</Base>
<style>
  .photo { aspect-ratio: 928/400; border: 6px solid #fff; border-radius: 40px; overflow: hidden; margin-bottom: 120px; }
  .photo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
  section { margin-bottom: 120px; }
  .cols { display: grid; grid-template-columns: 1fr 430px; gap: 68px; }
  .lead { font-size: 22px; color: var(--muted); max-width: 414px; }
  .right > p { margin-bottom: 1.1em; }
  .cards { margin-top: 36px; display: flex; flex-direction: column; gap: 16px; }
  .card { background: var(--accent); color: var(--on-accent); border-radius: 8px; padding: 0 22px; height: 142px; display: flex; align-items: center; justify-content: space-between; }
  .card h3 { font-size: 26px; font-weight: 600; line-height: 1.1; }
  .card p { font-size: 18px; line-height: 1.2; }
  .card i { width: 2px; height: 46px; background: rgba(18,18,18,0.1); }
  .card b { font-size: 60px; font-weight: 600; color: rgba(18,18,18,0.3); min-width: 150px; }
  .hl { list-style: none; }
  .hl li { display: flex; gap: 28px; padding: 22px 0; border-bottom: 1px solid var(--line); }
  .hl span { font-weight: 600; font-size: 20px; color: var(--accent-text); min-width: 28px; }
  @media (max-width: 900px) { section, .photo { margin-bottom: 80px; } .cols { grid-template-columns: 1fr; gap: 40px; } .card b { font-size: 44px; min-width: 0; } .photo { border-radius: 24px; aspect-ratio: 4/3; } }
</style>
