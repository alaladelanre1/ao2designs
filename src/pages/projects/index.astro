---
import Base from "../../layouts/Base.astro";
import PageTitle from "../../components/PageTitle.astro";
import { allProjects } from "../../data/projects/list";
---
<Base title="Projects — Olanrewaju Alalade" description="Case studies across fintech, health tech and enterprise platforms.">
  <PageTitle text="Projects" />
  <section class="container">
    <ul class="grid">
      {allProjects.map((p, i) => (
        <li>
          <a href={`/projects/${p.slug}`} style={`--pa:${p.accent ?? "var(--accent-text)"}`} class:list={{ soon: p.soon }}>
            <div class="thumb">
              {p.thumb
                ? <img src={p.thumb} alt="" loading={i < 4 ? "eager" : "lazy"} width="720" height="467" />
                : <div class="ph" aria-hidden="true"><span>{p.title}</span></div>}
              <span class="num">{String(i + 1).padStart(2, "0")}</span>
              {p.soon && <em class="badge">Coming soon</em>}
            </div>
            <div class="body">
              <small>{p.group}</small>
              <h2>{p.title}</h2>
              <p>{p.blurb}</p>
              <span class="view">{p.soon ? "Preview" : "View case study"} <i aria-hidden="true">↗</i></span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
<style>
  section { margin-bottom: 120px; }
  .grid { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 24px; }
  a { display: flex; flex-direction: column; height: 100%; background: var(--card); border: 1px solid var(--card-line); border-radius: 18px; overflow: hidden; transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s; }
  a:hover, a:focus-visible { transform: translateY(-4px); border-color: var(--pa); box-shadow: 0 18px 40px rgba(0, 0, 0, 0.25); }
  .thumb { position: relative; aspect-ratio: 3 / 2; overflow: hidden; background: color-mix(in srgb, var(--pa) 14%, var(--card)); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  a:hover .thumb img { transform: scale(1.05); }
  .ph { width: 100%; height: 100%; display: grid; place-items: center; padding: 24px; text-align: center; background: radial-gradient(circle at 30% 20%, color-mix(in srgb, var(--accent-text) 30%, transparent), transparent 60%), repeating-linear-gradient(45deg, transparent 0 14px, rgba(127, 127, 127, 0.08) 14px 15px); }
  .ph span { font-family: var(--font-display); font-weight: 900; font-size: clamp(36px, 6vw, 56px); line-height: 1; color: var(--accent-text); text-transform: uppercase; }
  .num { position: absolute; top: 14px; left: 14px; font-family: var(--font-display); font-weight: 700; font-size: 14px; letter-spacing: 0.06em; background: var(--bg); color: var(--pa); border-radius: 50px; padding: 3px 12px; }
  .badge { position: absolute; top: 14px; right: 14px; font-style: normal; font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; background: var(--accent); color: var(--on-accent); border-radius: 50px; padding: 4px 12px; }
  .body { display: flex; flex-direction: column; gap: 8px; padding: 22px 24px 24px; flex: 1; }
  small { font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  h2 { font-family: var(--font-display); font-weight: 700; font-size: 28px; line-height: 1.15; }
  p { font-size: 14px; color: var(--muted); line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .view { margin-top: auto; padding-top: 10px; font-size: 14px; font-weight: 500; color: var(--pa); }
  .view i { font-style: normal; display: inline-block; transition: transform 0.2s; }
  a:hover .view i { transform: translate(3px, -3px); }
  .soon .view { color: var(--muted); }
  @media (max-width: 900px) { section { margin-bottom: 80px; } .grid { gap: 16px; } }
  @media (prefers-reduced-motion: reduce) { a, .thumb img { transition: none; } }
</style>
